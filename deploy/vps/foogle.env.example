# Copied to /etc/foogle.env by install.sh. database/setup.sh fills in the rest:
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY and FOOGLE_JWT_SECRET.
#
# Email for sign-up confirmations and password resets. Filling these in turns
# sign-ups on; then rerun database/setup.sh (see deploy/vps/README.md).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=          (sender address; defaults to SMTP_USER)
# FOOGLE_SIGNUPS=off  (keep sign-ups closed but still allow password resets)
